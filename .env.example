# ---------------------------------------------------------------------------
# SmartZone Captive Portal — environment configuration
#
# For a fresh install, leave this file untouched and start the app: the setup
# wizard at https://your-host/setup will collect these values and write them
# back here automatically. You only need to edit this file by hand if you'd
# rather configure the portal without the wizard, or when changing settings
# later (you can also re-run the wizard from the admin UI).
# ---------------------------------------------------------------------------

# Set to "true" once the setup wizard has been completed. The wizard sets this
# itself — leave it false (or unset) on a fresh install so the wizard renders.
SETUP_COMPLETE=false

# --- Flask ------------------------------------------------------------------
# Long random string used to sign session cookies and magic-link tokens.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Public-facing base URL. Used in OAuth redirect URIs and email links.
# Must match the hostname clients hit (and the cert's SAN).
PORTAL_BASE_URL=https://portal.example.org

# --- Branding ---------------------------------------------------------------
# Shown on every page header and as the prefix on outbound email subjects.
PORTAL_BRAND_NAME=Captive Portal
# Optional: shown to end users as a "need help?" contact. Leave blank to hide.
PORTAL_SUPPORT_EMAIL=
# Optional: override the email input placeholder on the sign-in page. If
# blank, derives one from GOOGLE_HOSTED_DOMAIN (e.g. "you@example.org").
PORTAL_EMAIL_PLACEHOLDER=
# Optional: URL or /static/ path to a logo image (rendered ~56px high). If
# blank, the header shows the first letter of PORTAL_BRAND_NAME in a tile.
PORTAL_LOGO_URL=

# --- Database ---------------------------------------------------------------
# SQLite is fine for school-scale deployments (hundreds of devices). The file
# is created on first run. To use MariaDB/Postgres later:
#   mysql+pymysql://portal:portal@127.0.0.1:3306/captive_portal?charset=utf8mb4
DATABASE_URL=sqlite:///portal.db

# --- RADIUS server (we host) ------------------------------------------------
RADIUS_LISTEN_HOST=0.0.0.0
RADIUS_LISTEN_PORT=1812
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match exactly what you configure in the SmartZone AAA Auth Profile.
RADIUS_SHARED_SECRET=
# How SmartZone formats the MAC in User-Name. Match the WLAN's MAC auth format.
# Options: lower_no_sep | lower_colon | lower_hyphen | upper_no_sep | upper_colon | upper_hyphen
RADIUS_MAC_FORMAT=lower_no_sep

# --- SmartZone (we call out) ------------------------------------------------
SZ_HOST=sz.example.org
SZ_PORT=8443
# Match your controller version. SZ 6.1.1 = v11_1; SZ 7.0+ = v13_1.
SZ_API_VERSION=v11_1
SZ_USERNAME=
SZ_PASSWORD=
SZ_VERIFY_TLS=false

# --- CoA (we send to SmartZone after approval) ------------------------------
# Ruckus uses the same shared secret for RADIUS and CoA by default.
COA_HOST=sz.example.org
COA_PORT=3799
COA_SECRET=

# --- Google OAuth -----------------------------------------------------------
# Create at console.cloud.google.com -> APIs & Services -> Credentials ->
# OAuth client ID (Web application). Authorized redirect URI:
#   {PORTAL_BASE_URL}/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Workspace domain restriction. Leave blank to allow any Google account
# (not recommended for production).
GOOGLE_HOSTED_DOMAIN=

# --- Admin authorization ----------------------------------------------------
# Comma-separated emails (must be in GOOGLE_HOSTED_DOMAIN if set) that may
# approve/deny devices. These are the "bootstrap" admins; more can be added
# via the admin UI without editing this file.
ADMIN_EMAILS=

# --- Email (magic link / verification code) ---------------------------------
# Google Workspace SMTP relay (smtp-relay.gmail.com:587) works out of the box
# if you authorize the portal host's IP in Admin Console -> Apps -> Gmail ->
# Routing. For authenticated relay, set SMTP_USER and SMTP_PASS.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
# Defaults to PORTAL_BRAND_NAME if unset.
SMTP_FROM_NAME=
EMAIL_VERIFY_TTL_MINUTES=15

# --- Admin notifications ----------------------------------------------------
# Where new-pending-device alerts go. Each recipient gets a personalized email
# with one-click approve/deny magic links.
NOTIFY_EMAILS=
# Optional: also POST to a Slack incoming webhook.
NOTIFY_SLACK_WEBHOOK_URL=

# --- Retention --------------------------------------------------------------
EMAIL_VERIFY_RETENTION_DAYS=1
AUDIT_LOG_RETENTION_DAYS=90
