# --- Flask ---
FLASK_SECRET_KEY=change-me-to-a-long-random-string
PORTAL_BASE_URL=https://portal.hillmanschools.com

# --- Database ---
# Default: SQLite, single file in the project dir (no install required).
DATABASE_URL=sqlite:///portal.db
# To switch to MariaDB later, swap in:
# DATABASE_URL=mysql+pymysql://portal:portal@127.0.0.1:3306/smartzone_portal?charset=utf8mb4

# --- RADIUS server (we host) ---
RADIUS_LISTEN_HOST=0.0.0.0
RADIUS_LISTEN_PORT=1812
RADIUS_SHARED_SECRET=change-me-shared-with-smartzone
# How SmartZone formats the MAC in User-Name. Match the WLAN's MAC auth format.
# Options: lower_no_sep | lower_colon | lower_hyphen | upper_no_sep | upper_colon | upper_hyphen
RADIUS_MAC_FORMAT=lower_no_sep

# --- SmartZone (we call out) ---
SZ_HOST=sz.example.org
SZ_PORT=8443
SZ_API_VERSION=v13_1
SZ_USERNAME=apiservice
SZ_PASSWORD=change-me
SZ_VERIFY_TLS=false

# --- CoA (we send to SmartZone after approval) ---
COA_HOST=sz.example.org
COA_PORT=3799
COA_SECRET=change-me-shared-with-smartzone

# --- Google OAuth ---
GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxx
# Workspace domain restriction; leave blank to allow any Google account (not recommended).
GOOGLE_HOSTED_DOMAIN=hillmanschools.com

# --- Admin authorization ---
# Comma-separated emails (must be in GOOGLE_HOSTED_DOMAIN) that may approve/deny.
ADMIN_EMAILS=you@hillmanschools.com

# --- Email (magic link / verification code) ---
# Google Workspace SMTP relay. Requires the source IP to be allowed in
# Google Admin Console -> Apps -> Google Workspace -> Gmail -> Routing -> SMTP relay.
# If you use authenticated relay instead, set SMTP_USER and SMTP_PASS.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=admin@hillmanschools.com
SMTP_FROM_NAME=Hillman Wi-Fi
# How long a verification code/link is valid for (minutes)
EMAIL_VERIFY_TTL_MINUTES=15

# --- Notifications ---
# Slack webhook URL — leave blank to disable. Get one from Slack: Apps -> Incoming Webhooks.
NOTIFY_SLACK_WEBHOOK_URL=
# Comma-separated emails to notify on every new pending device. Leave blank to disable.
NOTIFY_EMAILS=

# --- Retention / cleanup ---
# Delete email_verifications rows after this many days (default 1)
EMAIL_VERIFY_RETENTION_DAYS=1
# Delete audit_log rows after this many days (default 90; 0 = never delete)
AUDIT_LOG_RETENTION_DAYS=90
