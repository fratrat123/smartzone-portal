[Unit]
Description=Captive Portal (Flask + RADIUS + setup wizard)
Documentation=https://github.com/your-org/captive-portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=captive-portal
Group=captive-portal
WorkingDirectory=/opt/captive-portal
EnvironmentFile=/opt/captive-portal/.env
ExecStart=/opt/captive-portal/.venv/bin/python3 -m gunicorn -c gunicorn.conf.py app:app
# Reload (SIGHUP) is how certbot's renewal hook tells gunicorn to pick up a
# rotated cert. Gunicorn gracefully cycles workers and the new cert is loaded.
ExecReload=/bin/kill -HUP $MAINPID

# Crash + setup-wizard "save and restart" both exit non-zero; systemd brings
# us back automatically. RestartSec is short so the wizard's exit feels snappy.
Restart=always
RestartSec=2

# Hardening
# NoNewPrivileges is intentionally NOT set — the setup wizard's "Network"
# step shells out to `sudo netplan apply` / `sudo hostnamectl` (scoped via
# /etc/sudoers.d/captive-portal) and NoNewPrivileges blocks SUID elevation.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/captive-portal /var/log/captive-portal /etc/letsencrypt /etc/netplan /var/lib/letsencrypt /var/log/letsencrypt
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

# Capabilities — bind 443/1812 without running as root.
# AmbientCapabilities adds CAP_NET_BIND_SERVICE to gunicorn workers so they
# can bind low ports. We intentionally do NOT restrict the
# CapabilityBoundingSet because the setup wizard's Network step shells out
# to `sudo netplan apply` and `sudo hostnamectl`, and sudo needs
# CAP_SETUID / CAP_SETGID / CAP_AUDIT_WRITE to do its job. Bounding-set
# restrictions block sudo elevation with "unable to change to root gid:
# Operation not permitted" — looks like a sudoers issue but isn't.
# The other hardening (ProtectSystem=strict, ReadWritePaths,
# ProtectKernel*, etc.) remains.
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=captive-portal

[Install]
WantedBy=multi-user.target
